// ── Constraints + Indexes ────────────────────────────────────
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Organisation`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Guideline`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Recommendation`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`GlycaemicTarget`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Table`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`MonitoringProtocol`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`TreatmentRecommendation`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Drug`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`ClinicalCondition`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Population`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Intervention`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Condition`) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Test`) REQUIRE n.id IS UNIQUE;

// Lookup indexes
CREATE INDEX IF NOT EXISTS FOR (n:`Drug`) ON (n.name);
CREATE INDEX IF NOT EXISTS FOR (n:`ClinicalCondition`) ON (n.name);
CREATE INDEX IF NOT EXISTS FOR (n:`Population`) ON (n.name);
CREATE INDEX IF NOT EXISTS FOR (n:`Intervention`) ON (n.name);
CREATE INDEX IF NOT EXISTS FOR (n:`Recommendation`) ON (n.label);
CREATE INDEX IF NOT EXISTS FOR (n:`GlycaemicTarget`) ON (n.metric);
CREATE INDEX IF NOT EXISTS FOR (n:`Guideline`) ON (n.organization);